# ============================================================
# AstrBot plugin runtime state
# ============================================================
# main.py persists the per-user "last game used" map into plugin_data/ inside
# the plugin directory at runtime (see MHHelperPlugin._plugin_state_dir).
# That is user data, never source.
plugin_data/
data/icons/

# ============================================================
# Local scrape artifacts (only the canonical data/ is committed)
# ============================================================
scraper/.cache/

# ============================================================
# Local debug / probe scripts that must never be tracked
# ============================================================
scripts/_*.py

# ============================================================
# Agent / tooling workspace data (memory notes, not plugin source)
# ============================================================
.workbuddy/
