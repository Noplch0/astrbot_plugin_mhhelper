# ============================================================
# AstrBot plugin runtime state
# ============================================================
# State now lives in AstrBot's own data/plugin_data/<plugin name>/ (see
# MHHelperPlugin._plugin_state_dir), but a plugin_data/ can still appear here:
# as the last-resort fallback, or left over from an install upgraded from
# v0.3.0. Either way it is user data, never source.
plugin_data/
data/icons/

# ============================================================
# Local scrape artifacts (only the canonical data/ is committed)
# ============================================================
scraper/.cache/

# ============================================================
# Local debug / probe scripts that must never be tracked
# ============================================================
scripts/_*.py

# ============================================================
# Agent / tooling workspace data (memory notes, not plugin source)
# ============================================================
.workbuddy/
